    { "op": "write", "sheet": "表1 总览", "range": "A1", "values": [["序号", "费用名称", "金额"], [1, "设计费", { "formula": "='表2.1 设计费'!C4" }], [2, "监理费", { "formula": "='表2.2 监理费'!C4" }], [3, "咨询费", { "formula": "='表2.3 咨询费'!C4" }], [null, "合计", { "formula": "=SUM(C2:C4)" }]] },
    { "op": "write", "sheet": "表2.1 设计费", "range": "A1", "values": [["序号", "项目", "金额"], [1, "方案设计", 120], [2, "施工图设计", 380], [null, "合计", { "formula": "=SUM(C2:C3)" }]] },
    { "op": "write", "sheet": "表2.2 监理费", "range": "A1", "values": [["序号", "项目", "金额"], [1, "施工监理", 210], [2, "保修期监理", 15], [null, "合计", { "formula": "=SUM(C2:C3)" }]] },
    { "op": "write", "sheet": "表2.3 咨询费", "range": "A1", "values": [["序号", "项目", "金额"], [1, "造价咨询", 64], [2, "招标代理", 22.5], [null, "合计", { "formula": "=SUM(C2:C3)" }]] },
