{
  "input": "sample/report-tables.xlsx",
  "output": "report-tables-styled.xlsx",
  "scriptPath": "recipe.js",
  "strict": true,
  "arguments": {
    "pattern": "^表2\\.\\d+ ",
    "expectSheets": 3,
    "format": [
      { "range": "A1:C1", "style": { "font": { "bold": true, "color": "FFFFFF" }, "fill": "1F4E78", "alignment": { "horizontal": "center" } } },
      { "range": "C2:C200", "style": { "numberFormat": "#,##0.00" } }
    ],
    "freeze": { "rows": 1, "columns": 0 },
    "print": { "orientation": "landscape", "paperSize": 9, "titles": { "rows": { "start": 1, "count": 1 } }, "scaling": { "mode": "fit", "width": 1, "height": 0 }, "headerFooter": { "oddHeader": "&C&A", "oddFooter": "&R第 &P 页" } },
    "view": { "zoomScale": 90, "showGridLines": false }
  }
}
