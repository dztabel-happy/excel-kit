    { "op": "sparkline.create", "sheet": "2026 01", "type": "column", "members": [{ "cell": "G8", "source": "'2026 01'!D4:D6" }] },
    { "op": "sheet.add", "name": "透视" },
    { "op": "pivot.create", "sheet": "透视", "name": "税额汇总", "cell": "A3", "source": "'2026 01'!$A$3:$F$6", "rows": ["项目"], "values": [{ "field": "税额", "aggregate": "sum", "name": "税额合计" }], "grandTotalCaption": "总计" }
  ]
}
