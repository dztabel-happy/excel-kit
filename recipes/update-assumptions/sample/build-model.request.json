{
  "create": { "sheets": ["假设", "计算", "汇总"] },
  "output": "sample/cost-model.xlsx",
  "operations": [
    { "op": "write", "sheet": "假设", "range": "A1", "values": [["参数", "取值", "单位"], ["建筑面积", 12000, "平方米"], ["单方造价", 4500, "元/平方米"], ["设计费率", 0.03, null], ["监理费率", 0.015, null], ["预备费率", 0.05, null], ["备注", "本表为合成样本", null]] },
    { "op": "write", "sheet": "计算", "range": "A1", "values": [["项目", "金额"], ["建安费", { "formula": "=假设!B2*假设!B3" }], ["设计费", { "formula": "=B2*假设!B4" }], ["监理费", { "formula": "=B2*假设!B5" }], ["小计", { "formula": "=SUM(B2:B4)" }], ["预备费", { "formula": "=B5*假设!B6" }]] },
    { "op": "write", "sheet": "汇总", "range": "A1", "values": [["指标", "数值"], ["总投资", { "formula": "=计算!B5+计算!B6" }], ["单方指标", { "formula": "=B2/假设!B2" }], ["生成日期", { "formula": "=TODAY()" }]] },
    { "op": "name.set", "name": "总投资", "reference": "汇总!$B$2" },
    { "op": "format", "sheet": "计算", "range": "B2:B6", "style": { "numberFormat": "#,##0.00" } },
    { "op": "format", "sheet": "汇总", "range": "B2:B3", "style": { "numberFormat": "#,##0.00" } }
  ]
}
